#!/usr/bin/env bash
# panel-new — create a panel session directory with intake, charter skeleton, roster.
# Usage: panel-new <slug> [--question "verbatim ask"] [--max-rounds N]
# Prints the absolute session dir.
set -euo pipefail
. "$(dirname "$0")/panel-lib.sh"
require_herdr
slug=""; question=""; max_rounds="$PANEL_MAX_ROUNDS"
while [ $# -gt 0 ]; do case "$1" in
  --question) question="$2"; shift 2;;
  --max-rounds) max_rounds="$2"; shift 2;;
  -h|--help) sed -n '2,5p' "$0"; exit 0;;
  -*) die "unknown arg: $1";;
  *) [ -z "$slug" ] || die "one slug only"; slug="$1"; shift;;
esac; done
[ -n "$slug" ] || die "usage: panel-new <slug> [--question TEXT] [--max-rounds N]"
slug="$(printf '%s' "$slug" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9\n' '-' | sed 's/-\{2,\}/-/g; s/^-//; s/-$//' | cut -c1-40)"
[ -n "$slug" ] || die "slug empty after sanitising"

sid="$(date +%Y%m%d-%H%M%S)-$slug"
d="$PANEL_SESSIONS_ROOT/$sid"
mkdir -p "$d/rounds"
printf '# Panel session %s — transcript\n\nAppend-only event chain. Times UTC.\n\n' "$sid" > "$d/transcript.md"
jq -n --arg id "$sid" --arg slug "$slug" --arg t "$(now_iso)" --argjson mr "$max_rounds" \
  --arg orch "$HERDR_PANE_ID" --arg ws "$HERDR_WORKSPACE_ID" \
  '{session_id:$id, slug:$slug, created:$t, updated:$t, state:"intake", max_rounds:$mr, orchestrator_pane:$orch, workspace:$ws}' \
  > "$d/session.json"
{
  printf '# Intake — %s\n\n## Request (verbatim from human)\n\n' "$sid"
  if [ -n "$question" ]; then printf '%s\n' "$question"; else printf '<<FILL: paste the human ask verbatim>>\n'; fi
  printf '\n## Clarifications (orchestrator ↔ human)\n\n- (none yet)\n'
} > "$d/00-intake.md"
render_template "$PANEL_TEMPLATES/charter.md" SESSION_ID="$sid" > "$d/charter.md"
transcript "$d" created "session $sid (max discussion rounds: $max_rounds)"
"$(dirname "$0")/panel-roster" --write "$d" >/dev/null
printf '%s\n' "$d"
