# panel.env — site-local configuration for the panel skill.
# Copy to ~/.config/agent-skills/panel.env (or point PANEL_ENV_FILE at this file) and edit.
# Precedence: real environment variable > this file > skill defaults — which is why every
# line uses the conditional form below: a variable already set in the environment WINS,
# so tests/scripts that export PANEL_* are never overridden by your site config.
# KEEP THIS OUT OF GIT — it names your hosts, paths and accounts.
# Plain `VAR=value` lines also work (they would then override the environment too).

# ---- where the panel workspace lives (sessions, manifest, state, snapshots) ----
export PANEL_SESSIONS_ROOT="${PANEL_SESSIONS_ROOT:-$HOME/dev/panels/sessions}"
export PANEL_MANIFEST="${PANEL_MANIFEST:-$HOME/dev/panels/panels.json}"
export PANEL_STATE_DIR="${PANEL_STATE_DIR:-$HOME/dev/panels/state}"

# ---- report publishing (GitHub) ----
# REQUIRED for panel-publish: <owner>/<repo>, created private on first use.
export PANEL_REPORT_REPO="${PANEL_REPORT_REPO:-your-account/panel-reports}"
export PANEL_REPORTS_CLONE="${PANEL_REPORTS_CLONE:-$HOME/dev/panel-reports}"

# ---- round tuning (defaults usually fine) ----
#export PANEL_MAX_ROUNDS=200
#export PANEL_PANEL_TIMEOUT_S=900
#export PANEL_COLLECT_TIMEOUT_S=540
#export PANEL_NUDGE_AFTER_S=90
